--!strict
-- Opening-only mix; original pack IDs are generated by the project asset uploader.
local AssetIds = require(game:GetService("ReplicatedStorage").Shared.AssetIds)
local Config = {}
export type Group = "Ambience" | "Box" | "Energy" | "Rarity" | "Impact" | "Reveal" | "UI"
export type Curve =
	{ volume: { number }, speed: { number }, volumePower: number, speedPower: number }
export type Cue = {
	group: Group,
	volume: number,
	speed: number,
	looped: boolean,
	fadeIn: number,
	fadeOut: number,
	lifetime: number,
	priority: number,
	fallback: string?,
	curve: Curve?,
}
Config.master = 0.45
-- Sum of linear gains is bounded even when all samples are correlated. Assets still need mastering.
Config.gainBudget = 0.8
Config.limit = 8
Config.loadTimeout = 2
Config.lateTolerance = 0.075
Config.mixFade = 0.07
Config.exitFade = 0.1
Config.impactCutAt = 0.11
Config.impactFade = 0.025
Config.discoveryAt = 0.55 -- reveal progress; after the result overlay begins to appear
Config.arrivalSettleAt = 0.58 -- back-ease turning point, normalized arrival progress
Config.shake = { minProgress = 0.2, spacing = 0.12, speeds = { 0.97, 1.02, 1 } }
Config.groups = { "Ambience", "Box", "Energy", "Rarity", "Impact", "Reveal", "UI" } :: { Group }
Config.mixes = {
	box = { Ambience = 1, Box = 1, Energy = 1, Rarity = 1, Impact = 1, Reveal = 1, UI = 1 },
	breakOpen = { Ambience = 0.25 },
	flight = { Ambience = 0.45, Energy = 1 },
	transform = { Ambience = 0.2, Energy = 0.42 },
	hold = { Ambience = 0.3, Energy = 0.6 },
	apex = { Ambience = 0.3, Energy = 0.42 },
	dive = { Ambience = 0.15, Energy = 1 },
	reveal = { Ambience = 0.3, Reveal = 1 },
	result = { Ambience = 0.55, Reveal = 1 },
} :: { [string]: { [Group]: number } }
Config.cues = {} :: { [string]: Cue }
Config.sounds = {} :: { [string]: string }
local function cue(
	key: string,
	group: Group,
	volume: number,
	priority: number,
	lifetime: number,
	looped: boolean?,
	fallback: string?
)
	local id =
		AssetIds["Audio.Opening." .. string.upper(string.sub(key, 1, 1)) .. string.sub(key, 2)]
	Config.sounds[key] = if id then "rbxassetid://" .. id else ""
	Config.cues[key] = {
		group = group,
		volume = volume,
		speed = 1,
		priority = priority,
		lifetime = lifetime,
		looped = looped == true,
		fadeIn = if looped then 0.1 else 0,
		fadeOut = if looped then 0.07 else 0.025,
		fallback = fallback,
	}
end
cue("ambience", "Ambience", 0.1, 1, 0, true)
cue("ambienceGrove", "Ambience", 0.1, 1, 0, true, "ambience")
cue("ambienceTide", "Ambience", 0.1, 1, 0, true, "ambience")
cue("entrance", "Box", 0.3, 3, 0.45)
cue("settle", "Box", 0.24, 3, 0.25)
cue("tension", "Energy", 0.1, 1, 0, true)
cue("charge", "Energy", 0.38, 2, 0, true)
cue("shake", "Box", 0.32, 3, 0.12)
cue("await", "Energy", 0.12, 1, 0, true, "tension")
cue("click", "UI", 0.35, 6, 0.09)
cue("compression", "Energy", 0.3, 4, 0.07)
cue("crack", "Box", 0.85, 8, 0.16)
cue("lid", "Box", 0.42, 4, 0.16)
cue("launch", "Energy", 0.62, 6, 0.3)
cue("flight", "Energy", 0.28, 2, 0, true)
cue("flightAir", "Energy", 0.18, 1, 0, true)
cue("flightMythical", "Energy", 0.28, 2, 0, true, "flight")
cue("acceleration", "Energy", 0.33, 3, 0.2)
cue("rarityTransformation", "Rarity", 0.4, 6, 0.3)
cue("transformLegendary", "Rarity", 0.5, 7, 0.16, false, "rarityTransformation")
cue("legendaryPulse", "Rarity", 0.52, 7, 0.38, false, "transformLegendary")
cue("mythicalInward", "Rarity", 0.27, 5, 0.045)
cue("mythicalPearl", "Rarity", 0.32, 6, 0.14)
cue("transformMythical", "Rarity", 0.5, 7, 0.65, false, "rarityTransformation")
for _, id in { "Common", "Uncommon", "Rare", "Legendary", "Mythical" } do
	cue("rarity" .. id, "Rarity", 0.48, 7, if id == "Mythical" then 0.8 else 0.55)
	cue("impact" .. id, "Impact", 0.82, 8, 0.3, false, "impact")
	cue("reveal" .. id, "Reveal", 0.6, 7, 0.8, false, "reveal")
end
cue("dive", "Energy", 0.4, 4, 0, true)
cue("impact", "Impact", 0.82, 8, 0.3)
cue("postImpactShimmer", "Reveal", 0.16, 2, 0.5)
cue("silhouette", "Ambience", 0.09, 1, 0, true)
cue("silhouetteMythical", "Ambience", 0.1, 1, 0, true, "silhouette")
cue("reveal", "Reveal", 0.6, 7, 0.8)
cue("discovery", "Reveal", 0.22, 4, 0.3)
cue("result", "Ambience", 0.1, 1, 0, true, "ambience")
cue("close", "UI", 0.22, 3, 0.1)
Config.cues.charge.curve =
	{ volume = { 0.25, 1 }, speed = { 0.86, 1.16 }, volumePower = 1.8, speedPower = 2.4 }
Config.cues.flight.curve =
	{ volume = { 0.38, 1 }, speed = { 0.94, 1.1 }, volumePower = 1.3, speedPower = 1.4 }
Config.cues.flightMythical.curve = Config.cues.flight.curve
Config.cues.flightAir.curve =
	{ volume = { 0.08, 1 }, speed = { 0.92, 1.12 }, volumePower = 1.8, speedPower = 1.2 }
Config.cues.dive.curve =
	{ volume = { 0.2, 1 }, speed = { 0.88, 1.16 }, volumePower = 1.7, speedPower = 1.8 }
Config.cues.dive.fadeIn = 0.025
return Config
