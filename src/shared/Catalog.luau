local comingSoon: { [string]: boolean } = {}
-- Content readiness only, never a discovery or progression unlock requirement.
-- An unapproved review GLB cannot be sold as if its production model were registered.
local productionOnly: { [string]: boolean } = {
	moon = true,
	dessert = true,
	halloween = true,
	chess = true,
	emotion = true,
	astral = true,
	biome = true,
	weather = true,
	sense = true,
	olympian = true,
	birthstone = true,
	sin = true,
	orbit = true,
}
for _, collection in collections do
	assert(not collectionIds[collection.id], "Duplicate collection ID")
	collectionIds[collection.id] = true
	comingSoon[collection.id] = collection.comingSoon == true
end
for _, figure in figures do
	assert(collectionIds[figure.collection], "Missing collection")
	if productionOnly[figure.collection] and not FigureEntries[figure.id] then
		comingSoon[figure.collection] = true
	end
end
return table.freeze({
	figures = table.freeze(figures),
	byId = table.freeze(byId),
	collections = collections,
	collectionIds = collectionIds,
	comingSoon = table.freeze(comingSoon),
	productionOnly = table.freeze(productionOnly),
})
